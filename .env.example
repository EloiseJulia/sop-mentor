# Copy this file to .env and fill in values.
# .env is excluded from git (see .gitignore).

# ---------------------------------------------------------------------------
# External LLM API keys
# Only needed when allow_external_llm: true in config/privacy.yaml
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Ollama (local — default provider)
# Override only if you run Ollama on a non-default address
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
